generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  HR_MANAGER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveType {
  SICK
  CASUAL
  VACATION
}

enum LeaveStatus {
  PENDING
  APPROVED_BY_MANAGER
  APPROVED_BY_HR
  REJECTED
}

enum PayrollStatus {
  PENDING
  PAID
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  budget     Decimal  @db.Decimal(12, 2)
  location   String   @db.VarChar(150)
  created_at DateTime @default(now())

  employees Employee[]

  @@map("departments")
}

model JobTitle {
  id               Int      @id @default(autoincrement())
  title            String   @unique @db.VarChar(100)
  salary_range_min Decimal  @db.Decimal(10, 2)
  salary_range_max Decimal? @db.Decimal(10, 2)

  employees Employee[]

  @@map("job_titles")
}

model Employee {
  id         Int    @id @default(autoincrement())
  first_name String @db.VarChar(50)
  last_name  String @db.VarChar(50)
  email      String @unique @db.VarChar(150)
  password   String @db.VarChar(255)
  role       Role   @default(USER)
  status     Status @default(ACTIVE)

  department_id Int
  department    Department @relation(fields: [department_id], references: [id], onDelete: Restrict)

  job_title_id Int
  job_title    JobTitle @relation(fields: [job_title_id], references: [id], onDelete: Restrict)

  manager_id   Int?
  manager      Employee?  @relation("ManagerToEmployee", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("ManagerToEmployee")

  created_at    DateTime       @default(now())
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]

  @@map("employees")
}

model LeaveRequest {
  id                  Int         @id @default(autoincrement())
  employeeId          Int         @map("employee_id")
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime    @map("end_date") @db.Date
  type                LeaveType
  status              LeaveStatus @default(PENDING)
  reason              String?     @db.Text
  approvedByManagerId Int?        @map("approved_by_manager_id")
  approvedByHrId      Int?        @map("approved_by_hr_id")
  employee            Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model Payroll {
  id             Int           @id @default(autoincrement())
  employeeId     Int           @map("employee_id")
  baseSalary     Decimal       @map("base_salary") @db.Decimal(10, 2)
  bonuses        Decimal       @default(0) @db.Decimal(10, 2)
  deductions     Decimal       @default(0) @db.Decimal(10, 2)
  totalSalary    Decimal       @default(0) @map("total_salary") @db.Decimal(10, 2)
  payPeriodStart DateTime      @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime      @map("pay_period_end") @db.Date
  status         PayrollStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, payPeriodStart, payPeriodEnd])
  @@map("payrolls")
}
